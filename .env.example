# ============================================================================
# MikroTik Cards Backend - Environment Variables Reference (.env.example)
# Copy to .env for local development or configure in Production Environment
# ============================================================================

# 1. Database Connection (PostgreSQL - e.g., Neon.tech / Cloud Postgres)
DATABASE_URL="postgresql://username:password@host:5432/database_name?sslmode=require"

# 2. Security & Cryptography Secrets
# JWT secret key for access token signing & verification
JWT_SECRET="your_jwt_secret_key_here"

# Encryption master key for router credentials (AES-256-GCM: 32 bytes / 64 hex chars)
ENCRYPTION_MASTER_KEY="your_64_character_hex_encryption_master_key_here"

# 3. SMTP Email Configuration (OTP & Transactional Emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_email@gmail.com"
SMTP_APP_PASSWORD="your_smtp_app_password_here"

# 4. Server Runtime Configuration
PORT=3000
HOST="0.0.0.0"
NODE_ENV="production"
LOG_LEVEL="info"

# 5. MikroTik Router Integration & Safety Controls
# Set to 'true' in production to allow router write mutations (creating hotspot users, disabling/enabling, disconnecting).
# When unset or 'false', runs in Read-Only Safety Mode (allowing live status probes only).
ENABLE_ROUTER_MUTATIONS="false"

# SSRF Network Security: Permitted CIDR subnets for routers reachable via internal VPN tunnels (comma-separated).
# Example: "10.8.0.0/24,192.168.100.0/24"
AUTHORIZED_VPN_SUBNETS=""

# Optional flag: Allow RFC1918 private IP ranges directly without VPN whitelist (strictly for local on-premise deployments only).
ALLOW_PRIVATE_ROUTER_IPS="false"

# Router diagnostic probe rate limiter & concurrency settings (optional)
ROUTER_PROBE_RATE_LIMIT_MAX="10"
ROUTER_PROBE_RATE_LIMIT_WINDOW_MS="60000"
ROUTER_PROBE_MAX_CONCURRENT="3"
